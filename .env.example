# Local containers from docker-compose.yml
DATABASE_URL=""
TEST_DATABASE_URL=""
REDIS_URI=""
TEST_REDIS_URI=""

# --- Auth0 -------------------------------------------------------------------
# AUTH0_DOMAIN must be a FULL URL, with https:// and a trailing slash. Both the
# REST middleware (issuerBaseURL) and the socket JWKS lookup build on it.
#   e.g. https://your-tenant.au.auth0.com/
AUTH0_DOMAIN=""

# The Identifier of your Auth0 API. Any URI you choose; it is never called.
# Must match VITE_AUTH0_AUDIENCE in the client exactly.
#   e.g. https://syncdraft.api
AUTH0_AUDIENCE=""
